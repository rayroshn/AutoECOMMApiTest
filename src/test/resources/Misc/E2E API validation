public class PhoneApiTest {

    @Test
    public void testPostAndDeserializePhoneList() throws Exception {
        // Step 1: Manually create POJO
        Features appleFeatures = new Features();
        appleFeatures.setScreen_size("6.1 inches");
        appleFeatures.setMemory("128 GB");
        appleFeatures.setCamera("12 MP");

        Phone apple = new Phone();
        apple.setBrand("Apple");
        apple.setModel("iPhone 13");
        apple.setFeatures(appleFeatures);
        apple.setPrice(799);

        List<Phone> phones = new ArrayList<>();
        phones.add(apple);

        PhoneList phoneListRequest = new PhoneList();
        phoneListRequest.setPhones(phones);

        // Step 2: Convert POJO to JSON
        ObjectMapper objectMapper = new ObjectMapper();
        String jsonBody = objectMapper.writeValueAsString(phoneListRequest);

        // Step 3: POST request
        Response response = RestAssured
            .given()
                .baseUri("https://your.api.endpoint") // Replace with real endpoint
                .basePath("/phones")                 // Adjust as needed
                .contentType(ContentType.JSON)
                .body(jsonBody)
            .when()
                .post()
            .then()
                .statusCode(200)
                .extract().response();

        // Step 4: Convert JSON response to POJO
        PhoneList phoneListResponse = objectMapper.readValue(response.asString(), PhoneList.class);

        // Step 5: Assert response values using Hamcrest
        assertThat(phoneListResponse.getPhones(), hasSize(1));
        assertThat(phoneListResponse.getPhones().get(0).getBrand(), is("Apple"));
        assertThat(phoneListResponse.getPhones().get(0).getFeatures().getCamera(), equalTo("12 MP"));
    }
}

